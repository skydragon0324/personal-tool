DATABASE_URL=postgresql://todo:todo@127.0.0.1:5433/daily_todo
# Dedicated test database — required for pytest. Must not be the same database as DATABASE_URL.
TEST_DATABASE_URL=postgresql://todo:todo@127.0.0.1:5433/daily_todo_test
# Docker Compose default instead:
# DATABASE_URL=postgresql://todo:todo@localhost:5432/daily_todo
# TEST_DATABASE_URL=postgresql://todo:todo@localhost:5432/daily_todo_test
CORS_ORIGINS=http://localhost:3000,http://localhost:3012
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
PUBLIC_BASE_URL=http://localhost:8000
ENVIRONMENT=development
# COOKIE_SECURE=true
# SESSION_TTL_DAYS=30

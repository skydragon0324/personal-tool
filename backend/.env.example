# ---------------------------------------------------------------------------
# Backend configuration. Copy this file to `.env` and adjust as needed:
#     copy .env.example .env
# The backend reads `.env` from the `backend/` directory, so always start
# uvicorn from inside `backend/`.
# ---------------------------------------------------------------------------

# Development database. 5432 is the default port for a standard PostgreSQL
# install. If you run Postgres on a non-default port, change it here.
DATABASE_URL=postgresql://todo:todo@127.0.0.1:5432/daily_todo

# Dedicated test database - required for pytest. This MUST be a different
# database than DATABASE_URL; the test suite refuses to fall back to it and
# wipes whatever it points at.
TEST_DATABASE_URL=postgresql://todo:todo@127.0.0.1:5432/daily_todo_test

# Origins allowed to call the API. The backend rejects mutating requests whose
# Origin header is not in this list, so the frontend URL must appear here.
CORS_ORIGINS=http://localhost:3000,http://localhost:3012

# Where task attachments are written, relative to `backend/`.
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760

PUBLIC_BASE_URL=http://localhost:8000
ENVIRONMENT=development

# Set COOKIE_SECURE=true only when serving over HTTPS. Leaving it unset means
# secure cookies switch on automatically when ENVIRONMENT=production.
# COOKIE_SECURE=true
# SESSION_TTL_DAYS=30

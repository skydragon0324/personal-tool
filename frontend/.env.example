# Frontend configuration. Copy this file to `.env.local`:
#     copy .env.example .env.local
#
# Base URL of the FastAPI backend, as the browser reaches it. No trailing slash.
# Keep it in step with PUBLIC_BASE_URL in backend/.env, and add this site's own address
# (e.g. http://your-server:3000) to CORS_ORIGINS there.
#
# Next.js builds this value into the app: after changing it, run `npm run build` again
# (the dev server, `npm run dev`, only needs a restart).
#
# Leave it unset to use port 8000 on the same host that serves the frontend.
NEXT_PUBLIC_API_URL=http://localhost:8000

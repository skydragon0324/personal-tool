# ---------------------------------------------------------------------------
# Frontend configuration. Copy this file to `.env.local`:
#     copy .env.example .env.local
#
# This file is optional. If NEXT_PUBLIC_API_URL is unset the app falls back to
# http://localhost:8000, which is correct for a standard local setup.
# ---------------------------------------------------------------------------

# Base URL of the FastAPI backend. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000

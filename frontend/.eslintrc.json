{
  "extends": "next/core-web-vitals",
  "rules": {
    // eslint-config-next 12.0.4 (the newest that supports Node 12.16) predates two fixes:
    // passHref is not needed with experimental.newNextLinkBehavior, and the custom-font
    // rule misreports fonts that are already in pages/_document.tsx on Windows.
    "@next/next/link-passhref": "off",
    "@next/next/no-page-custom-font": "off"
  }
}
